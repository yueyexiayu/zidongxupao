{
  "name": "zidongxupao",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH Desktop plugin: bounded, observable automatic recovery for retryable whole-turn failures.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
